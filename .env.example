# PostgreSQL connection. On a VPS use:
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/gontop
# For local development you may omit it and PGlite stores data in .data/gontop.
DATABASE_URL=

# Public URL used for payment redirects, webhooks and SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# UddoktaPay (server-only — never expose these with NEXT_PUBLIC_)
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com

# Optional Google sign-in (needed to keep existing Google-based customers)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Writable upload directory (local disk driver). On Vercel use external
# object storage instead, or paste image URLs in the admin panel.
UPLOAD_DIR=./.data/uploads

# Fulfillment driver. `manual` is the only bundled provider; supplier APIs
# implement lib/fulfillment.ts and register here.
FULFILLMENT_PROVIDER=manual

# Owner seed credentials (used by `npm run db:seed` only)
ADMIN_EMAIL=owner@gontop.app
ADMIN_PASSWORD=
ADMIN_NAME=Store Owner
SEED_DEMO=false
